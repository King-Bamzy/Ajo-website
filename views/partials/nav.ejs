<nav class="top-nav" aria-label="Primary">
  <a class="brand" href="/">
    <span class="brand-mark">Ajo</span>
    <span class="brand-name" aria-label="Thrift Collection">
      <span>Thrift</span>
      <span>Collection</span>
    </span>
  </a>

  <div class="nav-actions">
    <% if (user) { %>
      <span class="nav-user" title="<%= user.email %>">Hi, <%= user.name %></span>
      <a class="btn ghost" href="/account">My savings</a>
      <% if (user.role === "admin") { %>
        <a class="btn ghost" href="/admin">Admin</a>
      <% } %>
      <form class="nav-logout" method="post" action="/auth/logout">
        <button class="btn ghost" type="submit">Log out</button>
      </form>
    <% } else { %>
      <a class="btn ghost" href="/auth/login?next=%2Faccount">Log in</a>
      <a class="btn primary" href="/auth/signup?next=%2Faccount">Sign up</a>
    <% } %>
  </div>
</nav>
