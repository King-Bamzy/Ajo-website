<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ajo Thrift Collection</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <div class="app-shell">
      <%- include("partials/nav", { user }) %>

      <header class="hero">
        <div class="hero-copy">
          <p class="eyebrow">Representative-assisted thrift savings</p>
          <h1>Track your thrift savings online while collections still happen in person.</h1>
          <p>
            Your representative can still introduce the service, collect money physically, and keep
            the relationship customers already trust. The website is here to reduce paper work,
            speed things up, and make each account easier to follow.
          </p>
          <div class="hero-actions">
            <% if (user) { %>
              <a class="btn primary" href="/account">Open my savings</a>
              <a class="btn ghost" href="/support">Get support</a>
            <% } else { %>
              <a class="btn primary" href="/auth/signup?next=%2Faccount">Create account</a>
              <a class="btn ghost" href="/auth/login?next=%2Faccount">Log in</a>
            <% } %>
          </div>
        </div>

        <div class="hero-panel">
          <p class="hero-panel-title">What happens after sign up</p>
          <ol class="steps-list">
            <% steps.forEach((step) => { %>
              <li><%= step %></li>
            <% }) %>
          </ol>
        </div>
      </header>

      <main>
        <section class="trust-banner">
          <div>
            <p class="eyebrow">Built for physical collection</p>
            <h2>The website supports the representative. It does not replace them.</h2>
          </div>
          <p class="muted">
            Customers can still hand over savings physically to someone they know, while the
            website makes records, support, and progress easier to access.
          </p>
        </section>

        <section class="feature-section">
          <header>
            <h2>What customers can do on the website</h2>
            <p>Just the useful parts customers need after the representative has already explained the service.</p>
          </header>
          <div class="feature-grid">
            <% highlights.forEach((highlight) => { %>
              <article class="feature-card">
                <h3><%= highlight.title %></h3>
                <p><%= highlight.copy %></p>
              </article>
            <% }) %>
          </div>
        </section>

        <section class="access-grid" aria-label="Account access">
          <article class="access-card">
            <p class="label">New customer</p>
            <h2>Create an account</h2>
            <p class="muted">A representative can help open your account so you can choose your savings plan after sign up.</p>
            <a class="btn primary" href="/auth/signup?next=%2Faccount">Sign up</a>
          </article>

          <article class="access-card">
            <p class="label">Existing customer</p>
            <h2>Log in to your account</h2>
            <p class="muted">Return to see your savings plans, collection schedule, and support details.</p>
            <a class="btn ghost" href="/auth/login?next=%2Faccount">Log in</a>
          </article>

          <article class="access-card">
            <p class="label">Need help</p>
            <h2>Support and policies</h2>
            <p class="muted">Find contact help, privacy information, and basic website terms in one place.</p>
            <div class="link-row">
              <a class="admin-link" href="/support">Support</a>
              <a class="admin-link" href="/privacy">Privacy</a>
              <a class="admin-link" href="/terms">Terms</a>
            </div>
          </article>
        </section>

        <section class="faq">
          <header>
            <h2>Frequently asked questions</h2>
            <p>Answers customers may need when the representative is not around.</p>
          </header>
          <div class="faq-grid">
            <% faqs.forEach((faq) => { %>
              <details>
                <summary><%= faq.question %></summary>
                <p class="muted"><%= faq.answer %></p>
              </details>
            <% }) %>
          </div>
        </section>
      </main>

      <footer class="site-footer" aria-label="Footer">
        <div class="footer-grid">
          <div>
            <p class="eyebrow">Ajo Thrift Collection</p>
            <p class="muted">Digital support for a trusted representative-led thrift savings process.</p>
          </div>
          <div>
            <p class="footer-title">Support</p>
            <p class="muted">WhatsApp: +234 801 234 5678</p>
            <p class="muted">Email: support@ajo.local</p>
          </div>
          <div>
            <p class="footer-title">Website links</p>
            <p class="muted"><a class="admin-link" href="/privacy">Privacy policy</a></p>
            <p class="muted"><a class="admin-link" href="/terms">Terms of use</a></p>
          </div>
        </div>
        <p class="muted footer-bottom">Built to reduce paper work while keeping the trusted physical collection model in place.</p>
      </footer>
    </div>
  </body>
</html>
